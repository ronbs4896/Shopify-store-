        "promo_slide_VbFPBy": {
          "type": "promo-slide",
          "settings": {
            "block_heading": "הרבה יותר יפה במציאות",
            "text_1": "<p><strong>מיכל, 22, נתיבות</strong><br/><br/>הזמנתי את השרשרת והיא פשוט מושלמת. היא עדינה, נוצצת ונראית יוקרתית מאוד. קיבלתי עליה כבר המון מחמאות, ואני לגמרי אחזור להזמין שוב. ★★★★★</p>",
            "show_slide_2": false,
            "block_heading_2": "Nice Product",
            "text_2": "<p><strong>שני ל., שירות אישי ומקצועי</strong><br/><br/>הייתה לי שאלה לפני ההזמנה וקיבלתי מענה מהיר, סבלני ומקצועי. המשלוח הגיע ארוז בצורה מהממת והתכשיט היה בדיוק כמו בתמונות. חוויית קנייה מעולה. ★★★★★</p>",
            "show_slide_3": false,
            "block_heading_3": "Recomended",
            "text_3": "<p>Share information about your brand with your customers. Describe a product, make announcements, or welcome customers to your store. ★★★★★</p>",
            "color_scheme": "background-1",
            "slide_padding": 20,
            "show_border": false,
            "border_color": "#e4e4e4",
            "slide_wrapper_radius": 0,
            "slide_img_size": 60,
            "slide_img_radius": 100,
