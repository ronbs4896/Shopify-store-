    "seora_faq": {
      "type": "seora-faq",
      "blocks": {
        "faq_x1": {
          "type": "question",
          "settings": {
            "question": "מה זה מוסאנייט ובמה הוא שונה מיהלום?",
            "answer": "<p>מוסאנייט היא אבן חן מעבדתית, השנייה בקשיותה אחרי היהלום, עם ברק ואש צבעונית גבוהים משל יהלום. ההבדל העיקרי הוא המחיר: מוסאנייט בדרגת D / VVS1 עולה חלק קטן ממחיר יהלום טבעי במראה דומה.</p>"
          }
        },
        "faq_x2": {
          "type": "question",
          "settings": {
            "question": "האם התכשיט עמיד במים?",
            "answer": "<p>כן. התכשיטים עשויים כסף סטרלינג S925 בציפוי רודיום ועמידים במים. כדי לשמור על הברק לאורך זמן מומלץ להסיר אותם לפני מגע עם כלור, כימיקלים וקרמים.</p>"
          }
        },
        "faq_x3": {
          "type": "question",
          "settings": {
            "question": "מה מגיע באריזה?",
            "answer": "<p>התכשיט מגיע בקופסת תכשיט מהודרת ובשקית יוקרתית, יחד עם תעודה גמולוגית וכרטיס מקוריות של GRA. מוכן להענקה כמתנה.</p>"
          }
        },
        "faq_1": {
          "type": "question",
          "settings": {
            "question": "מהם זמני המשלוח?",
            "answer": "<p>זמן הכנת ההזמנה משתנה בהתאם לסוג התכשיט ולזמינותו במלאי. לאחר השלמת ההכנה, ההזמנה תישלח לכתובת שהוזנה בעת הרכישה. זמני המשלוח המדויקים מופיעים בעמוד המוצר ובשלב התשלום.</p>"
          }
        },
        "faq_2": {
          "type": "question",
          "settings": {
            "question": "אילו אפשרויות תשלום קיימות באתר?",
            "answer": "<p>ניתן לשלם באמצעות כרטיסי אשראי בצורה מאובטחת. בהתאם לסכום ההזמנה, ניתן לבחור גם באפשרות של תשלום בתשלומים, בכפוף לתנאי חברת האשראי.</p>"
          }
        },
        "faq_3": {
          "type": "question",
          "settings": {
            "question": "האם קיימת אחריות על התכשיטים?",
            "answer": "<p>כן. התכשיטים שלנו מגיעים עם אחריות בהתאם לסוג התכשיט ולתנאים המפורטים בתעודת האחריות. האחריות אינה כוללת נזק שנגרם כתוצאה משימוש לא תקין, מכה, שבר, שריטה או אובדן.</p>"
          }
        },
        "faq_4": {
          "type": "question",
          "settings": {
            "question": "האם ניתן להחליף או להחזיר תכשיט?",
            "answer": "<p>ניתן להגיש בקשה להחלפה או להחזרה בהתאם למדיניות ההחזרות וההחלפות של החנות. התכשיט חייב להיות חדש, ללא שימוש, באריזתו המקורית ובצירוף הוכחת רכישה. לא ניתן להחזיר תכשיטים שיוצרו או הותאמו אישית.</p>"
          }
        },
        "faq_5": {
          "type": "question",
          "settings": {
            "question": "האם ניתן לשנות את מידת הטבעת לאחר ההזמנה?",
            "answer": "<p>בחלק מהדגמים ניתן לבצע שינוי מידה. מומלץ לבדוק היטב את המידה לפני ביצוע ההזמנה באמצעות מדריך המידות באתר. במקרה של טעות במידה, ניתן לפנות לשירות הלקוחות לבדיקת אפשרויות ההתאמה.</p>"
          }
        },
        "faq_6": {
          "type": "question",
          "settings": {
            "question": "כיצד ניתן לעקוב אחר ההזמנה?",
            "answer": "<p>לאחר שההזמנה תצא למשלוח, יישלח אליכם עדכון עם פרטי המשלוח וקישור למעקב. ניתן גם לפנות לשירות הלקוחות עם מספר ההזמנה ולקבל עדכון על סטטוס ההזמנה.</p>"
          }
        }
      },
