    "e80cb7bb-7295-4d49-bbf9-cb8f0fdd2f92": {
      "type": "collapsible-content",
      "blocks": {
        "template--20428573212984__e80cb7bb-7295-4d49-bbf9-cb8f0fdd2f92-collapsible_row-2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "מהם זמני המשלוח?",
            "icon": "none",
            "row_content": "<p>זמן הכנת ההזמנה משתנה בהתאם לסוג התכשיט ולזמינותו במלאי. לאחר השלמת ההכנה, ההזמנה תישלח לכתובת שהוזנה בעת הרכישה. זמני המשלוח המדויקים מופיעים בעמוד המוצר ובשלב התשלום.</p><h3></h3>",
            "page": ""
          }
        },
        "template--20428573212984__e80cb7bb-7295-4d49-bbf9-cb8f0fdd2f92-collapsible_row-3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "אילו אפשרויות תשלום קיימות באתר?",
            "icon": "none",
            "row_content": "<p>ניתן לשלם באמצעות כרטיסי אשראי בצורה מאובטחת. בהתאם לסכום ההזמנה, ניתן לבחור גם באפשרות של תשלום בתשלומים, בכפוף לתנאי חברת האשראי.</p>",
            "page": ""
          }
        },
        "4f82fe7e-cbd8-48ee-8eac-c4c0d675189e": {
          "type": "collapsible_row",
          "settings": {
            "heading": "האם קיימת אחריות על התכשיטים?",
            "icon": "none",
            "row_content": "<p>כן. התכשיטים שלנו מגיעים עם אחריות בהתאם לסוג התכשיט ולתנאים המפורטים בתעודת האחריות. האחריות אינה כוללת נזק שנגרם כתוצאה משימוש לא תקין, מכה, שבר, שריטה או אובדן.</p><h3></h3>",
            "page": ""
          }
        },
        "83ca6b89-d3b8-4d97-9e69-effe4cf282f5": {
          "type": "collapsible_row",
          "settings": {
            "heading": "האם ניתן להחליף או להחזיר תכשיט?",
            "icon": "none",
            "row_content": "<p>ניתן להגיש בקשה להחלפה או להחזרה בהתאם למדיניות ההחזרות וההחלפות של החנות. התכשיט חייב להיות חדש, ללא שימוש, באריזתו המקורית ובצירוף הוכחת רכישה. לא ניתן להחזיר תכשיטים שיוצרו או הותאמו אישית.</p>",
            "page": ""
          }
        },
        "b063c876-e8c2-4de3-aff7-6afa1ce75e44": {
          "type": "collapsible_row",
          "settings": {
            "heading": "האם ניתן לשנות את מידת הטבעת לאחר ההזמנה?",
            "icon": "none",
            "row_content": "<p>בחלק מהדגמים ניתן לבצע שינוי מידה. מומלץ לבדוק היטב את המידה לפני ביצוע ההזמנה באמצעות מדריך המידות באתר. במקרה של טעות במידה, ניתן לפנות לשירות הלקוחות לבדיקת אפשרויות ההתאמה.</p>",
            "page": ""
          }
        },
        "collapsible_row_b4p7hR": {
          "type": "collapsible_row",
          "settings": {
            "heading": "כיצד ניתן לעקוב אחר ההזמנה?",
            "icon": "none",
            "row_content": "<p>לאחר שההזמנה תצא למשלוח, יישלח אליכם עדכון עם פרטי המשלוח וקישור למעקב. ניתן גם לפנות לשירות הלקוחות עם מספר ההזמנה ולקבל עדכון על סטטוס ההזמנה.</p>",
            "page": ""
          }
        }
      },
