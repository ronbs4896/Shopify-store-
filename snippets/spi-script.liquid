{%- comment -%} Client-side logic for main-product-seora {%- endcomment -%}
<script>
  (function () {
    if (customElements.get('seora-product-info')) return;

    class SeoraProductInfo extends HTMLElement {
      connectedCallback() {
        this.symbol = this.dataset.symbol || '₪';
        this.picker = this.querySelector('variant-radios');
        const json = this.picker && this.picker.querySelector('script[type="application/json"]');
        this.variants = json ? JSON.parse(json.textContent) : [];
        this.currentVariant = this.variants.find((v) => String(v.id) === String(this.dataset.variantId)) || null;

        this.addEventListener('change', (e) => {
          const t = e.target;
          if (t.matches('variant-radios input[type="radio"]')) {
            // let the theme's variant-radios handler run first, then sync our UI
            setTimeout(() => this.onVariantChange(), 0);
          } else if (t.matches('.spi-bundle__check')) {
            this.toggleBundle();
          } else if (t.matches('.spi-bundle__variant')) {
            this.updateBundle();
          }
        });

        this.addEventListener('click', (e) => {
          const btn = e.target.closest('.spi-bundle__add');
          if (btn) this.addBundleOnly(btn);
          const rm = e.target.closest('.spi-bundle__remove');
          if (rm) this.removeBundleOnly(rm);
        });

        // if the added item is removed from the cart drawer, the card button goes back to "add"
        if (typeof subscribe === 'function' && typeof PUB_SUB_EVENTS !== 'undefined') {
          subscribe(PUB_SUB_EVENTS.cartUpdate, (event) => {
            if (!event || event.source === 'spi-bundle' || !event.cartData || !event.cartData.items) return;
            const addBtn = this.querySelector('.spi-bundle__add.is-added');
            if (!addBtn || !addBtn.dataset.lineKey) return;
            const still = event.cartData.items.some((i) => i.key === addBtn.dataset.lineKey);
            if (still) return;
            addBtn.querySelector('span').textContent = addBtn.dataset.label;
            addBtn.classList.remove('is-added');
            addBtn.removeAttribute('aria-disabled');
            addBtn.dataset.lineKey = '';
            const rmBtn = this.querySelector('.spi-bundle__remove');
            if (rmBtn) rmBtn.hidden = true;
          });
        }

        this.productForm = this.querySelector('product-form');
        if (this.productForm) {
          this.productForm.addEventListener('submit', (e) => this.onSubmit(e), true);
        }
        this.updateBundle();
      }

      money(cents) {
        const n = Math.round(Number(cents) || 0);
        const whole = n % 100 === 0;
        const amount = (n / 100).toLocaleString('en-US', {
          minimumFractionDigits: whole ? 0 : 2,
          maximumFractionDigits: 2,
        });
        return this.symbol + amount;
      }

      getSelectedVariant() {
        if (this.picker && this.picker.currentVariant !== undefined) return this.picker.currentVariant || null;
        if (!this.picker) return this.currentVariant;
        const chosen = Array.from(this.picker.querySelectorAll('fieldset')).map((f) => {
          const r = f.querySelector('input:checked');
          return r ? r.value : null;
        });
        return this.variants.find((v) => v.options.every((o, i) => o === chosen[i])) || null;
      }

      onVariantChange() {
        const v = this.getSelectedVariant();
        this.currentVariant = v;
        if (!v) return;
        this.dataset.variantId = v.id;
        this.updateLabels();
        this.updatePrice(v);
        this.updateStock(v);
        this.updateBundle();
      }

      updateLabels() {
        if (!this.picker) return;
        this.picker.querySelectorAll('fieldset').forEach((f) => {
          const r = f.querySelector('input:checked');
          const label = f.querySelector('.spi-opt__value');
          if (r && label) label.textContent = r.value;
        });
      }

      updatePrice(v) {
        const box = this.querySelector('.spi-price');
        if (!box) return;
        const onSale = v.compare_at_price && v.compare_at_price > v.price;
        const sale = box.querySelector('.spi-price__sale');
        const compare = box.querySelector('.spi-price__compare');
        const save = box.querySelector('.spi-price__save');
        if (sale) {
          sale.textContent = this.money(v.price);
          sale.classList.toggle('spi-price__sale--regular', !onSale);
        }
        if (compare) {
          compare.textContent = this.money(v.compare_at_price || 0);
          compare.hidden = !onSale;
        }
        if (save) {
          save.hidden = !onSale;
          const span = save.querySelector('span');
          if (span && onSale) span.textContent = this.money(v.compare_at_price - v.price);
        }
        const inst = box.querySelector('.spi-installments__text') || box.querySelector('.spi-installments');
        const count = parseInt(box.dataset.installments || '0', 10);
        if (inst && count > 1) {
          const tpl = box.dataset.installmentsText || '';
          inst.innerHTML = tpl
            .replace('{count}', String(count))
            .replace('{amount}', '<b>' + this.money(v.price / count) + '</b>');
        }
        box.classList.remove('hidden');
      }

      updateStock(v) {
        const box = this.querySelector('.spi-stock');
        if (!box) return;
        const badge = box.querySelector('.spi-badge');
        if (!badge) return;
        const inText = this.dataset.stockIn || '';
        const outText = this.dataset.stockOut || '';
        const dot = badge.querySelector('.spi-badge__dot');
        if (v.available) {
          badge.classList.add('spi-badge--in');
          badge.classList.remove('spi-badge--out');
          if (dot) dot.hidden = false;
          // real units left, only when the variant tracks stock and is at or under the limit
          let map = {};
          try { map = JSON.parse(this.dataset.stockMap || '{}'); } catch (e) {}
          const qty = map[String(v.id)];
          const limit = parseInt(this.dataset.stockLimit, 10) || 10;
          const low = typeof qty === 'number' && qty > 0 && qty <= limit;
          badge.classList.toggle('spi-badge--low', low);
          let text = inText;
          if (low && qty === 1 && this.dataset.stockOne) text = this.dataset.stockOne;
          else if (low && this.dataset.stockLow) text = this.dataset.stockLow.replace('{n}', qty);
          badge.lastChild.textContent = text;
        } else {
          badge.classList.remove('spi-badge--in');
          badge.classList.add('spi-badge--out');
          badge.classList.remove('spi-badge--low');
          if (dot) dot.hidden = true;
          badge.lastChild.textContent = outText;
        }
        box.classList.remove('hidden');
      }

      toggleBundle() {
        const wrap = this.querySelector('.spi-bundle');
        const check = this.querySelector('.spi-bundle__check');
        if (wrap && check) wrap.classList.toggle('spi-bundle--checked', check.checked);
      }

      updateBundle() {
        const wrap = this.querySelector('.spi-bundle');
        if (!wrap) return;
        const v = this.currentVariant || this.getSelectedVariant();
        const addonEl = wrap.querySelector('.spi-bundle__variant');
        if (!v || !addonEl) return;
        const opt = addonEl.tagName === 'SELECT' ? addonEl.options[addonEl.selectedIndex] : addonEl;
        const addonPrice = parseInt(opt.dataset.price, 10) || 0;
        const addonCompare = parseInt(opt.dataset.compare, 10) || addonPrice;
        const pct = parseFloat(wrap.dataset.pct) || 0;
        const mode = wrap.dataset.mode || 'set';
        let price;
        let cmp;
        if (mode === 'addon_pct') {
          price = Math.round(addonPrice * (100 - pct) / 100);
          cmp = addonCompare;
        } else if (mode === 'addon_price') {
          price = parseInt(wrap.dataset.offer, 10) || 0;
          cmp = addonCompare;
        } else if (mode === 'regular') {
          price = addonPrice;
          cmp = addonCompare;
        } else if (mode === 'gift') {
          price = 0;
          cmp = addonCompare;
        } else {
          const mainCompare = v.compare_at_price || v.price;
          price = Math.round((v.price + addonPrice) * (100 - pct) / 100);
          cmp = mainCompare + addonCompare;
        }
        const sale = wrap.querySelector('.spi-bundle__sale');
        const compare = wrap.querySelector('.spi-bundle__compare');
        if (sale) sale.textContent = mode === 'gift' ? (wrap.dataset.freeText || this.money(0)) : this.money(price);
        if (compare) {
          compare.textContent = this.money(cmp);
          compare.hidden = cmp <= price;
        }
      }

      // Adds only the complementary item (the variant chosen in its card) and opens the cart drawer.
      // The button then stays on "added" and a remove button appears next to it.
      addBundleOnly(btn) {
        const wrap = this.querySelector('.spi-bundle');
        const addonEl = wrap && wrap.querySelector('.spi-bundle__variant');
        if (!addonEl || !addonEl.value || btn.disabled || btn.classList.contains('is-added')) return;
        const label = btn.querySelector('span');
        const removeBtn = wrap.querySelector('.spi-bundle__remove');
        const drawer = document.querySelector('cart-drawer');
        const body = { items: [{ id: parseInt(addonEl.value, 10), quantity: 1 }] };
        if (drawer && typeof drawer.getSectionsToRender === 'function') {
          body.sections = drawer.getSectionsToRender().map((s) => s.id);
          body.sections_url = window.location.pathname;
        }
        btn.disabled = true;
        btn.classList.add('is-loading');
        fetch((window.routes && window.routes.cart_add_url ? window.routes.cart_add_url : '/cart/add') + '.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
          body: JSON.stringify(body),
        })
          .then((r) => r.json())
          .then((state) => {
            if (state.status) throw state;
            const line = state.items && state.items[0];
            btn.dataset.lineKey = line ? line.key : '';
            label.textContent = btn.dataset.added;
            btn.classList.add('is-added');
            btn.setAttribute('aria-disabled', 'true');
            if (removeBtn) removeBtn.hidden = false;
            if (typeof publish === 'function' && typeof PUB_SUB_EVENTS !== 'undefined') {
              publish(PUB_SUB_EVENTS.cartUpdate, { source: 'spi-bundle', productVariantId: addonEl.value, cartData: state });
            }
            if (drawer && state.sections) {
              drawer.classList.remove('is-empty');
              drawer.renderContents(state);
            } else {
              window.location.href = (window.routes && window.routes.cart_url) || '/cart';
            }
          })
          .catch((e) => {
            console.error('bundle add failed', e);
            label.textContent = btn.dataset.error;
            btn.classList.add('is-error');
            setTimeout(() => {
              label.textContent = btn.dataset.label;
              btn.classList.remove('is-error');
            }, 2500);
          })
          .finally(() => {
            btn.disabled = false;
            btn.classList.remove('is-loading');
          });
      }

      // Removes the complementary item added from the card and refreshes the cart without opening it.
      removeBundleOnly(rm) {
        const wrap = this.querySelector('.spi-bundle');
        const btn = wrap && wrap.querySelector('.spi-bundle__add');
        const addonEl = wrap && wrap.querySelector('.spi-bundle__variant');
        if (!btn || rm.disabled) return;
        const drawer = document.querySelector('cart-drawer');
        const body = { id: btn.dataset.lineKey || String(addonEl ? addonEl.value : ''), quantity: 0 };
        if (drawer && typeof drawer.getSectionsToRender === 'function') {
          body.sections = drawer.getSectionsToRender().map((s) => s.id);
          body.sections_url = window.location.pathname;
        }
        rm.disabled = true;
        fetch((window.routes && window.routes.cart_change_url ? window.routes.cart_change_url : '/cart/change') + '.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
          body: JSON.stringify(body),
        })
          .then((r) => r.json())
          .then((state) => {
            if (state.status) throw state;
            if (drawer && state.sections) {
              drawer.getSectionsToRender().forEach((section) => {
                const el = section.selector ? document.querySelector(section.selector) : document.getElementById(section.id);
                if (el && state.sections[section.id]) {
                  el.innerHTML = drawer.getSectionInnerHTML(state.sections[section.id], section.selector);
                }
              });
              if (state.item_count === 0) drawer.classList.add('is-empty');
            }
            if (typeof publish === 'function' && typeof PUB_SUB_EVENTS !== 'undefined') {
              publish(PUB_SUB_EVENTS.cartUpdate, { source: 'spi-bundle', cartData: state });
            }
            btn.querySelector('span').textContent = btn.dataset.label;
            btn.classList.remove('is-added');
            btn.removeAttribute('aria-disabled');
            btn.dataset.lineKey = '';
            rm.hidden = true;
          })
          .catch((e) => console.error('bundle remove failed', e))
          .finally(() => {
            rm.disabled = false;
          });
      }

      onSubmit(evt) {
        const check = this.querySelector('.spi-bundle__check');
        const addonEl = this.querySelector('.spi-bundle__variant');
        if (!check || !check.checked || !addonEl || this._bundleAdding) return;
        const addonId = addonEl.value;
        if (!addonId) return;

        evt.preventDefault();
        evt.stopImmediatePropagation();
        this._bundleAdding = true;

        const submit = this.productForm.querySelector('[type="submit"]');
        if (submit) submit.classList.add('loading');

        fetch((window.routes && window.routes.cart_add_url ? window.routes.cart_add_url : '/cart/add') + '.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
          body: JSON.stringify({ items: [{ id: parseInt(addonId, 10), quantity: 1 }] }),
        })
          .catch((e) => console.error('bundle add failed', e))
          .then(() => {
            // now let the theme's product-form add the main product and open the cart drawer
            if (typeof this.productForm.onSubmitHandler === 'function') {
              this.productForm.onSubmitHandler(evt);
            } else {
              this.productForm.querySelector('form').submit();
            }
          })
          .finally(() => {
            this._bundleAdding = false;
          });
      }
    }

    customElements.define('seora-product-info', SeoraProductInfo);
  })();
</script>
