{%- comment -%}
  Floating WhatsApp button (bottom left), opens a chat with the business number and a ready message.
  Rendered once from layout/theme.liquid. On product pages it sits higher on mobile, above the sticky add-to-cart bar.
{%- endcomment -%}
{%- liquid
  assign wa_number = '972523199277'
  assign wa_text = 'היי, הגעתי דרך האתר, אשמח לדבר עם נציג.' | url_encode | replace: '+', '%20'
-%}
<a
  class="seora-wa{% if template.name == 'product' %} seora-wa--product{% endif %}"
  href="https://wa.me/{{ wa_number }}?text={{ wa_text }}"
  target="_blank"
  rel="noopener"
  aria-label="שיחה עם נציג בוואטסאפ"
>
  <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <path fill="currentColor" d="M16.04 3C9.08 3 3.42 8.63 3.42 15.56c0 2.22.58 4.38 1.69 6.29L3.3 28.5l6.84-1.78a12.6 12.6 0 0 0 5.9 1.5h.01c6.96 0 12.62-5.63 12.63-12.56C28.68 8.63 23.01 3 16.04 3Zm0 22.98h-.01c-1.88 0-3.73-.5-5.34-1.46l-.38-.23-4.06 1.06 1.08-3.94-.25-.4a10.36 10.36 0 0 1-1.6-5.55c0-5.76 4.71-10.45 10.52-10.45 2.81 0 5.45 1.09 7.43 3.07a10.36 10.36 0 0 1 3.08 7.39c0 5.76-4.72 10.51-10.47 10.51Zm5.76-7.83c-.32-.16-1.87-.92-2.16-1.02-.29-.11-.5-.16-.71.16-.21.31-.82 1.02-1 1.23-.18.21-.37.24-.68.08-.32-.16-1.33-.49-2.54-1.56-.94-.83-1.57-1.86-1.76-2.17-.18-.31-.02-.48.14-.64.14-.14.32-.37.47-.55.16-.18.21-.31.32-.52.1-.21.05-.39-.03-.55-.08-.16-.71-1.7-.97-2.33-.26-.61-.52-.53-.71-.54h-.61c-.21 0-.55.08-.84.39-.29.31-1.1 1.07-1.1 2.62 0 1.54 1.13 3.03 1.29 3.24.16.21 2.22 3.37 5.38 4.73.75.32 1.34.52 1.8.66.75.24 1.44.2 1.98.12.6-.09 1.87-.76 2.13-1.49.26-.73.26-1.36.18-1.49-.08-.13-.29-.21-.6-.37Z"/>
  </svg>
</a>
<style>
  .seora-wa {
    position: fixed;
    left: 16px;
    bottom: 20px;
    z-index: 98;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #25d366;
    color: #ffffff;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.22);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .seora-wa svg { width: 32px; height: 32px; }
  .seora-wa:hover { transform: scale(1.06); box-shadow: 0 8px 22px rgba(0, 0, 0, 0.28); }
  .seora-wa:focus-visible { outline: 3px solid #128c7e; outline-offset: 3px; }
  @media screen and (max-width: 749px) {
    .seora-wa { width: 52px; height: 52px; left: 14px; bottom: 16px; }
    .seora-wa svg { width: 30px; height: 30px; }
    .seora-wa--product { bottom: 92px; }
  }
  @media screen and (min-width: 750px) {
    .seora-wa { left: 24px; bottom: 24px; }
  }
  @media print { .seora-wa { display: none; } }
</style>
