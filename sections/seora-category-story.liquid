{%- comment -%}
  ŚEORA - category story. One block per category; the section shows only the block
  that matches the product. Category is read from the product title:
  first word "סט" = set, then עגיל = earrings, שרשר/תליון = necklace, צמיד = bracelet, טבעת = ring.
{%- endcomment -%}
{{ 'seora-cro.css' | asset_url | stylesheet_tag }}
<script src="{{ 'seora-cro.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign s = section.settings
  assign cat = 'default'
  if product
    assign t = product.title
    assign first_word = t | split: ' ' | first
    if first_word contains 'סט'
      assign cat = 'set'
    elsif t contains 'עגיל'
      assign cat = 'earrings'
    elsif t contains 'שרשר' or t contains 'תליון'
      assign cat = 'necklace'
    elsif t contains 'צמיד'
      assign cat = 'bracelet'
    elsif t contains 'טבעת'
      assign cat = 'ring'
    endif
  endif

  assign story = nil
  for block in section.blocks
    if block.settings.category == cat
      assign story = block
      break
    endif
  endfor
  if story == nil
    for block in section.blocks
      if block.settings.category == 'default'
        assign story = block
        break
      endif
    endfor
  endif
-%}
{%- if story -%}
  {%- assign b = story.settings -%}
  {% render 'seora-section-vars', section: section %}
  <div id="scro-{{ section.id }}" class="scro scro-story gradient color-{{ s.color_scheme }}" data-category="{{ cat }}">
    <div class="page-width" {{ story.shopify_attributes }}>
      <div class="scro__head">
        {%- if b.eyebrow != blank -%}<p class="scro__eyebrow">{{ b.eyebrow | escape }}</p>{%- endif -%}
        {%- if b.heading != blank -%}<h2 class="scro__heading">{{ b.heading | escape }}</h2><span class="scro__rule" aria-hidden="true"></span>{%- endif -%}
        {%- if b.text != blank -%}<div class="scro__sub"><p>{{ b.text | escape }}</p></div>{%- endif -%}
      </div>

      <ul class="scro-story__grid" role="list">
        {%- for i in (1..3) -%}
          {%- liquid
            assign k_icon = 'm' | append: i | append: '_icon'
            assign k_title = 'm' | append: i | append: '_title'
            assign k_text = 'm' | append: i | append: '_text'
            assign m_title = b[k_title]
            assign m_text = b[k_text]
          -%}
          {%- if m_title != blank or m_text != blank -%}
            <li class="scro-story__card">
              <span class="scro-item__icon" aria-hidden="true">{% render 'seora-icon', icon: b[k_icon] %}</span>
              {%- if m_title != blank -%}<h3 class="scro-item__title">{{ m_title | escape }}</h3>{%- endif -%}
              {%- if m_text != blank -%}<p class="scro-item__text">{{ m_text | escape }}</p>{%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {% render 'seora-cta', label: b.cta_label, action: s.cta_action, product: product %}

      {%- if b.link_label != blank and b.link_url != blank -%}
        <p class="scro-story__link"><a href="{{ b.link_url }}">{{ b.link_label | escape }}</a></p>
      {%- endif -%}
      {%- if s.gift_text != blank -%}
        <p class="scro-story__gift">{% render 'seora-icon', icon: 'gift' %}<span>{{ s.gift_text }}</span></p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "סיפור לפי קטגוריה",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "paragraph", "content": "מוצג רק הבלוק שמתאים לקטגוריה של המוצר, לפי שם המוצר: סט, עגילים, שרשרת/תליון, צמיד, טבעת. מוצר שלא מתאים לאף אחת מקבל את בלוק ברירת המחדל." },
    { "type": "select", "id": "cta_action", "label": "פעולת הכפתור", "options": [ { "value": "auto", "label": "חכם: מוסיף לסל, או גולל לבחירת מידה אם יש אפשרויות" }, { "value": "add", "label": "הוספה לסל של הבחירה הנוכחית" }, { "value": "scroll", "label": "גלילה לאזור הקנייה" } ], "default": "scroll" },
    { "type": "inline_richtext", "id": "gift_text", "label": "שורת מתנה (לכל הקטגוריות)", "default": "<strong>קונים במתנה?</strong> אפשר להחליף תוך 14 ימי עסקים, כל עוד התכשיט לא נענד ונמצא באריזה המקורית." },
    { "type": "header", "content": "עיצוב" },
    { "type": "color_scheme", "id": "color_scheme", "label": "ערכת צבעים", "default": "background-1" },
    { "type": "color", "id": "bg_color", "label": "צבע רקע לסקשן (ריק = לפי ערכת הצבעים)" },
    { "type": "color", "id": "accent_color", "label": "צבע הדגשה", "default": "#a8894f" },
    { "type": "color", "id": "button_bg", "label": "כפתור - רקע", "default": "#111111" },
    { "type": "color", "id": "button_color", "label": "כפתור - טקסט", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "label": "ריווח עליון", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "ריווח תחתון", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "קטגוריה",
      "settings": [
        { "type": "select", "id": "category", "label": "קטגוריה", "options": [
          { "value": "bracelet", "label": "צמידים" }, { "value": "necklace", "label": "שרשראות ותליונים" }, { "value": "earrings", "label": "עגילים" },
          { "value": "ring", "label": "טבעות" }, { "value": "set", "label": "סטים" }, { "value": "default", "label": "ברירת מחדל" } ], "default": "default" },
        { "type": "text", "id": "eyebrow", "label": "כותרת עליונה קטנה" },
        { "type": "text", "id": "heading", "label": "כותרת", "default": "מהתכשיטים האלה שפשוט עובדים" },
        { "type": "textarea", "id": "text", "label": "טקסט פתיחה" },
        { "type": "header", "content": "מסר 1" },
        { "type": "select", "id": "m1_icon", "label": "אייקון", "options": [ { "value": "sparkles", "label": "נצנוץ" }, { "value": "diamond", "label": "יהלום" }, { "value": "heart", "label": "לב" }, { "value": "shield", "label": "מגן" }, { "value": "water", "label": "עמיד במים" }, { "value": "gift", "label": "מתנה" }, { "value": "certificate", "label": "תעודה" }, { "value": "ring", "label": "טבעת" }, { "value": "star", "label": "כוכב" }, { "value": "ruler", "label": "סרגל" } ], "default": "sparkles" },
        { "type": "text", "id": "m1_title", "label": "כותרת" },
        { "type": "textarea", "id": "m1_text", "label": "טקסט" },
        { "type": "header", "content": "מסר 2" },
        { "type": "select", "id": "m2_icon", "label": "אייקון", "options": [ { "value": "sparkles", "label": "נצנוץ" }, { "value": "diamond", "label": "יהלום" }, { "value": "heart", "label": "לב" }, { "value": "shield", "label": "מגן" }, { "value": "water", "label": "עמיד במים" }, { "value": "gift", "label": "מתנה" }, { "value": "certificate", "label": "תעודה" }, { "value": "ring", "label": "טבעת" }, { "value": "star", "label": "כוכב" }, { "value": "ruler", "label": "סרגל" } ], "default": "heart" },
        { "type": "text", "id": "m2_title", "label": "כותרת" },
        { "type": "textarea", "id": "m2_text", "label": "טקסט" },
        { "type": "header", "content": "מסר 3" },
        { "type": "select", "id": "m3_icon", "label": "אייקון", "options": [ { "value": "sparkles", "label": "נצנוץ" }, { "value": "diamond", "label": "יהלום" }, { "value": "heart", "label": "לב" }, { "value": "shield", "label": "מגן" }, { "value": "water", "label": "עמיד במים" }, { "value": "gift", "label": "מתנה" }, { "value": "certificate", "label": "תעודה" }, { "value": "ring", "label": "טבעת" }, { "value": "star", "label": "כוכב" }, { "value": "ruler", "label": "סרגל" } ], "default": "gift" },
        { "type": "text", "id": "m3_title", "label": "כותרת" },
        { "type": "textarea", "id": "m3_text", "label": "טקסט" },
        { "type": "header", "content": "כפתור וקישור" },
        { "type": "text", "id": "cta_label", "label": "טקסט כפתור (ריק = בלי כפתור)", "default": "בחרי את שלך" },
        { "type": "text", "id": "link_label", "label": "קישור משני - טקסט" },
        { "type": "url", "id": "link_url", "label": "קישור משני - כתובת" }
      ]
    }
  ],
  "presets": [ { "name": "סיפור לפי קטגוריה", "blocks": [ { "type": "story" } ] } ]
}
{% endschema %}
