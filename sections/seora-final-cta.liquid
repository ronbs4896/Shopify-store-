{%- comment -%} ŚEORA - closing call to action {%- endcomment -%}
{{ 'seora-cro.css' | asset_url | stylesheet_tag }}
<script src="{{ 'seora-cro.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign s = section.settings
  assign pct = s.rating | times: 20.0 | at_most: 100
  if product
    assign cv = product.selected_or_first_available_variant
  endif
-%}
{%- capture star -%}<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5l2.95 6.2 6.8.85-5 4.75 1.3 6.75L12 17.7l-6.05 3.35 1.3-6.75-5-4.75 6.8-.85z"/></svg>{%- endcapture -%}
{% render 'seora-section-vars', section: section %}
{%- style -%}
  #scro-{{ section.id }} { --scro-final-bg: {{ s.box_bg }}; --scro-final-fg: {{ s.box_color }}; --scro-star: {{ s.star_color }}; }
{%- endstyle -%}
<div id="scro-{{ section.id }}" class="scro scro-final{% if s.style == 'flat' %} scro-final--flat{% endif %} gradient color-{{ s.color_scheme }}">
  <div class="page-width">
    <div class="scro-final__box">
      {%- if s.show_image and product.featured_media -%}
        <div class="scro-final__thumb">{{ product.featured_media | image_url: width: 300 | image_tag: loading: 'lazy', alt: product.title }}</div>
      {%- endif -%}
      {%- if s.show_rating -%}
        <div class="scro-final__rating">
          <span class="scro-stars" role="img" aria-label="{{ s.rating }} / 5"><span>{{ star }}{{ star }}{{ star }}{{ star }}{{ star }}</span><span class="scro-stars__fg" style="width: {{ pct }}%;">{{ star }}{{ star }}{{ star }}{{ star }}{{ star }}</span></span>
          {%- if s.rating_text != blank -%}<span>{{ s.rating_text | escape }}</span>{%- endif -%}
        </div>
      {%- endif -%}
      {%- if s.heading != blank -%}<h2 class="scro__heading">{{ s.heading | escape }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<div class="scro__sub">{{ s.text }}</div>{%- endif -%}
      {%- if s.show_price and cv -%}
        <div class="scro-final__price">
          <span class="scro-final__price-now">{% render 'seora-money', amount: cv.price %}</span>
          {%- if cv.compare_at_price > cv.price -%}<s class="scro-final__price-was">{% render 'seora-money', amount: cv.compare_at_price %}</s>{%- endif -%}
        </div>
      {%- endif -%}

      {% render 'seora-cta', label: s.cta_label, action: s.cta_action, link: s.cta_link, sub: s.cta_sub, product: product %}

      {%- liquid
        assign t1 = s.trust_1 | strip
        assign t2 = s.trust_2 | strip
        assign t3 = s.trust_3 | strip
      -%}
      {%- if t1 != blank or t2 != blank or t3 != blank -%}
        <ul class="scro-final__trust" role="list">
          {%- if t1 != blank %}<li>{% render 'seora-icon', icon: 'certificate' %}{{ t1 | escape }}</li>{% endif -%}
          {%- if t2 != blank %}<li>{% render 'seora-icon', icon: 'shield' %}{{ t2 | escape }}</li>{% endif -%}
          {%- if t3 != blank %}<li>{% render 'seora-icon', icon: 'gift' %}{{ t3 | escape }}</li>{% endif -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "קריאה לפעולה סופית",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "checkbox", "id": "show_image", "label": "הצג תמונת מוצר בעיגול", "default": true },
    { "type": "checkbox", "id": "show_rating", "label": "הצג כוכבים", "default": true },
    { "type": "range", "id": "rating", "label": "דירוג", "min": 1, "max": 5, "step": 0.1, "default": 5 },
    { "type": "text", "id": "rating_text", "label": "טקסט ליד הכוכבים", "default": "הבחירה של לקוחות ŚEORA" },
    { "type": "text", "id": "heading", "label": "כותרת", "default": "הברק של יהלום. בעשירית מהמחיר." },
    { "type": "richtext", "id": "text", "label": "טקסט", "default": "<p>כל תכשיט מגיע עם תעודה גמולוגית של GRA, אחריות יבואן רשמי לשנה ואריזת מתנה מהודרת.</p>" },
    { "type": "checkbox", "id": "show_price", "label": "הצג מחיר", "default": true },
    { "type": "header", "content": "כפתור" },
    { "type": "text", "id": "cta_label", "label": "טקסט כפתור", "default": "אני רוצה את שלי" },
    { "type": "select", "id": "cta_action", "label": "פעולת הכפתור", "options": [ { "value": "auto", "label": "חכם: מוסיף לסל, או גולל לבחירת מידה אם יש אפשרויות" }, { "value": "add", "label": "הוספה לסל של הבחירה הנוכחית" }, { "value": "scroll", "label": "גלילה לאזור הקנייה" }, { "value": "link", "label": "קישור" } ], "default": "auto" },
    { "type": "url", "id": "cta_link", "label": "קישור (אם נבחר 'קישור')" },
    { "type": "text", "id": "cta_sub", "label": "טקסט קטן מתחת לכפתור" },
    { "type": "header", "content": "שורת אמון" },
    { "type": "text", "id": "trust_1", "label": "פריט 1", "default": "תעודת GRA" },
    { "type": "text", "id": "trust_2", "label": "פריט 2", "default": "אחריות יבואן לשנה" },
    { "type": "text", "id": "trust_3", "label": "פריט 3", "default": "אריזת מתנה" },
    { "type": "header", "content": "עיצוב" },
    { "type": "select", "id": "style", "label": "סגנון", "options": [ { "value": "box", "label": "קופסה צבעונית" }, { "value": "flat", "label": "שקוף (צבעי הערכה)" } ], "default": "box" },
    { "type": "color", "id": "box_bg", "label": "רקע הקופסה", "default": "#111111" },
    { "type": "color", "id": "box_color", "label": "טקסט בקופסה", "default": "#ffffff" },
    { "type": "color", "id": "star_color", "label": "צבע כוכבים", "default": "#e3c47b" },
    { "type": "color_scheme", "id": "color_scheme", "label": "ערכת צבעים (רקע הסקשן)", "default": "background-1" },
    { "type": "color", "id": "accent_color", "label": "צבע הדגשה", "default": "#c9a86a" },
    { "type": "color", "id": "button_bg", "label": "כפתור - רקע", "default": "#c9a86a" },
    { "type": "color", "id": "button_color", "label": "כפתור - טקסט", "default": "#111111" },
    { "type": "range", "id": "padding_top", "label": "ריווח עליון", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "ריווח תחתון", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 }
  ],
  "presets": [ { "name": "קריאה לפעולה סופית" } ]
}
{% endschema %}
