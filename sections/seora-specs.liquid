{%- comment -%}
  ŚEORA - "what to know" spec table next to a product image.
  The plating row is worked out per product: metafield custom.plating wins; otherwise
  gold is detected from the title, option values and description (זהב / צהוב / רוז; the
  descriptions carry "צבע: זהב" and "ציפוי זהב 18K"), and silver from option values
  (כסף / לבן). Gold + silver options = both texts; nothing found = rhodium.
{%- endcomment -%}
{{ 'seora-cro.css' | asset_url | stylesheet_tag }}
<script src="{{ 'seora-cro.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign s = section.settings
  assign img = s.image
  if img == blank and product and s.product_image > 0
    assign idx = s.product_image | minus: 1
    assign m = product.media[idx]
    if m == blank
      assign m = product.featured_media
    endif
    assign img = m.preview_image
  endif
  assign img_alt = img.alt | default: s.heading | escape

  assign has_gold = false
  assign has_silver = false
  if product
    assign haystack = product.title
    for opt in product.options_with_values
      assign haystack = haystack | append: ' ' | append: opt.name
      assign joined = opt.values | join: ' '
      assign haystack = haystack | append: ' ' | append: joined
      if joined contains 'כסף' or joined contains 'לבן'
        assign has_silver = true
      endif
    endfor
    if haystack contains 'זהב' or haystack contains 'צהוב' or haystack contains 'רוז'
      assign has_gold = true
    elsif product.description contains 'זהב'
      assign has_gold = true
    endif
  endif
-%}
{% render 'seora-section-vars', section: section %}
<div id="scro-{{ section.id }}" class="scro scro-split scro-specs scro-split--media-{{ s.media_position }}{% if s.full_width %} scro-split--full{% endif %} gradient color-{{ s.color_scheme }}">
  <div class="{% if s.full_width %}scro-split__wrap{% else %}page-width{% endif %}">
    <div class="scro-split__grid">
      <div class="scro-split__media scro-split__media--{{ s.image_ratio }}">
        {%- if img != blank -%}
          {{ img | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '375, 550, 750, 1000, 1400', sizes: '(min-width: 750px) 50vw, 100vw', alt: img_alt }}
        {%- else -%}
          <div class="scro-ph">{{ 'image' | placeholder_svg_tag }}</div>
        {%- endif -%}
      </div>

      <div class="scro-split__content">
        <div class="scro__head scro__head--start">
          {%- if s.eyebrow != blank -%}<p class="scro__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
          {%- if s.heading != blank -%}<h2 class="scro__heading">{{ s.heading | escape }}</h2><span class="scro__rule" aria-hidden="true"></span>{%- endif -%}
        </div>

        {%- if section.blocks.size > 0 -%}
          <dl class="scro-specs__list">
            {%- for block in section.blocks -%}
              {%- liquid
                assign bs = block.settings
                assign value = bs.value
                if block.type == 'plating'
                  assign override = product.metafields.custom.plating.value
                  if override != blank
                    assign value = override
                  elsif has_gold and has_silver
                    assign value = bs.value_both
                  elsif has_gold
                    assign value = bs.value_gold
                  else
                    assign value = bs.value
                  endif
                endif
              -%}
              {%- if bs.label != blank and value != blank -%}
                <div class="scro-specs__row" {{ block.shopify_attributes }}>
                  <dt>{{ bs.label | escape }}</dt>
                  <dd>{{ value | escape }}</dd>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </dl>
        {%- endif -%}

        {%- if s.note != blank -%}<p class="scro-specs__note">{{ s.note | escape }}</p>{%- endif -%}

        {% render 'seora-cta', label: s.cta_label, action: s.cta_action, sub: s.cta_sub, align: 'start', product: product %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "מה חשוב לדעת (מפרט)",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "כותרת עליונה קטנה", "default": "מפרט" },
    { "type": "text", "id": "heading", "label": "כותרת", "default": "מה חשוב לדעת" },
    { "type": "text", "id": "note", "label": "שורה מתחת לטבלה", "default": "כל מה שצריך לדעת, בלי אותיות קטנות." },
    { "type": "header", "content": "תמונה" },
    { "type": "image_picker", "id": "image", "label": "תמונה" },
    { "type": "range", "id": "product_image", "label": "אם לא נבחרה תמונה: תמונת מוצר מס'", "min": 0, "max": 10, "step": 1, "default": 3, "info": "0 = בלי תמונת מוצר." },
    { "type": "select", "id": "image_ratio", "label": "יחס תמונה", "options": [ { "value": "square", "label": "ריבוע" }, { "value": "portrait", "label": "לאורך" }, { "value": "landscape", "label": "לרוחב" }, { "value": "adapt", "label": "מקורי" } ], "default": "square" },
    { "type": "select", "id": "media_position", "label": "מיקום התמונה בדסקטופ", "options": [ { "value": "first", "label": "ימין" }, { "value": "second", "label": "שמאל" } ], "default": "second" },
    { "type": "checkbox", "id": "full_width", "label": "רוחב מלא (100%)", "default": true },
    { "type": "header", "content": "כפתור" },
    { "type": "text", "id": "cta_label", "label": "טקסט כפתור (ריק = בלי כפתור)", "default": "לבחירת התכשיט שלי" },
    { "type": "select", "id": "cta_action", "label": "פעולת הכפתור", "options": [ { "value": "auto", "label": "חכם: מוסיף לסל, או גולל לבחירת מידה אם יש אפשרויות" }, { "value": "add", "label": "הוספה לסל של הבחירה הנוכחית" }, { "value": "scroll", "label": "גלילה לאזור הקנייה" } ], "default": "auto" },
    { "type": "text", "id": "cta_sub", "label": "טקסט קטן מתחת לכפתור" },
    { "type": "header", "content": "עיצוב" },
    { "type": "color_scheme", "id": "color_scheme", "label": "ערכת צבעים", "default": "background-1" },
    { "type": "color", "id": "bg_color", "label": "צבע רקע לסקשן (ריק = לפי ערכת הצבעים)" },
    { "type": "color", "id": "accent_color", "label": "צבע הדגשה", "default": "#a8894f" },
    { "type": "color", "id": "button_bg", "label": "כפתור - רקע", "default": "#111111" },
    { "type": "color", "id": "button_color", "label": "כפתור - טקסט", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "label": "ריווח עליון", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "ריווח תחתון", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "שורה",
      "settings": [
        { "type": "text", "id": "label", "label": "שם", "default": "חומר" },
        { "type": "text", "id": "value", "label": "ערך", "default": "כסף סטרלינג S925" }
      ]
    },
    {
      "type": "plating",
      "name": "שורת ציפוי (אוטומטית)",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "הערך נבחר לפי המוצר: זהב אם בשם, באפשרויות או בתיאור מופיע זהב/צהוב/רוז, שניהם אם יש גם כסף/לבן באפשרויות, אחרת רודיום. שדה מוצר custom.plating גובר על הכל." },
        { "type": "text", "id": "label", "label": "שם", "default": "ציפוי" },
        { "type": "text", "id": "value", "label": "ערך רגיל", "default": "רודיום" },
        { "type": "text", "id": "value_gold", "label": "ערך למוצר בגוון זהב", "default": "זהב 18K" },
        { "type": "text", "id": "value_both", "label": "ערך למוצר עם כמה גוונים", "default": "רודיום או זהב 18K, לפי הגוון שבוחרים" }
      ]
    }
  ],
  "presets": [ { "name": "מה חשוב לדעת (מפרט)", "blocks": [ { "type": "row" }, { "type": "plating" } ] } ]
}
{% endschema %}
