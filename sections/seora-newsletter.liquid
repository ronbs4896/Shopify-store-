{%- comment -%}
  SEORA newsletter ("מועדון הלקוחות"): dark card with a slow gold glow, a heading with a light sweep,
  an email form with a shining button, and three benefits with icons. Elements fade up when the
  section scrolls into view. All motion stops under prefers-reduced-motion.
  Uses Shopify's customer form, so sign-ups land in Customers with email marketing consent.
{%- endcomment -%}
{%- liquid
  assign ss = section.settings
  assign form_id = 'SeoraNewsletter-' | append: section.id
-%}
{%- style -%}
  #snl-{{ section.id }} {
    --snl-bg: {{ ss.bg_color }};
    --snl-card: {{ ss.card_color }};
    --snl-text: {{ ss.text_color }};
    --snl-muted: {{ ss.text_color | color_modify: 'alpha', 0.68 }};
    --snl-line: {{ ss.text_color | color_modify: 'alpha', 0.12 }};
    --snl-gold: {{ ss.accent_color }};
    --snl-gold-soft: {{ ss.accent_color | color_modify: 'alpha', 0.18 }};
    padding-top: {{ ss.padding_top }}px;
    padding-bottom: {{ ss.padding_bottom }}px;
  }
{%- endstyle -%}

<section id="snl-{{ section.id }}" class="snl" dir="rtl" aria-labelledby="snl-title-{{ section.id }}">
  <div class="snl__wrap">
    <div class="snl__card">
      <span class="snl__glow" aria-hidden="true"></span>
      <span class="snl__spark snl__spark--1" aria-hidden="true">✦</span>
      <span class="snl__spark snl__spark--2" aria-hidden="true">✦</span>
      <span class="snl__spark snl__spark--3" aria-hidden="true">✦</span>

      <div class="snl__top">
        <div class="snl__copy">
          {%- if ss.eyebrow != blank -%}
            <p class="snl__eyebrow snl__reveal">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              <span>{{ ss.eyebrow }}</span>
            </p>
          {%- endif -%}
          <h2 id="snl-title-{{ section.id }}" class="snl__title snl__reveal">{{ ss.heading }}</h2>
          {%- if ss.text != blank -%}
            <p class="snl__text snl__reveal">{{ ss.text }}</p>
          {%- endif -%}
        </div>

        <div class="snl__form-wrap snl__reveal">
          {%- form 'customer', id: form_id, class: 'snl__form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            {%- if form.posted_successfully? -%}
              <p class="snl__msg snl__msg--ok" role="status" tabindex="-1" autofocus>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                <span>{{ ss.success_text }}</span>
              </p>
            {%- else -%}
              <div class="snl__field">
                <label class="visually-hidden" for="{{ form_id }}-email">{{ ss.placeholder }}</label>
                <input
                  id="{{ form_id }}-email"
                  class="snl__input"
                  type="email"
                  name="contact[email]"
                  value="{{ form.email }}"
                  placeholder="{{ ss.placeholder }}"
                  autocomplete="email"
                  autocorrect="off"
                  autocapitalize="off"
                  dir="rtl"
                  required
                  {% if form.errors %}aria-invalid="true" aria-describedby="{{ form_id }}-error"{% endif %}
                >
                <button type="submit" class="snl__btn" name="commit">
                  <span>{{ ss.button_label }}</span>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>
                </button>
              </div>
              {%- if form.errors -%}
                <p id="{{ form_id }}-error" class="snl__msg snl__msg--err" role="alert">{{ ss.error_text }}</p>
              {%- endif -%}
              {%- if ss.consent_text != blank -%}
                <p class="snl__consent">{{ ss.consent_text }}</p>
              {%- endif -%}
            {%- endif -%}
          {%- endform -%}
        </div>
      </div>

      <ul class="snl__perks" role="list">
        {%- if ss.perk_1 != blank -%}
          <li class="snl__perk snl__reveal">
            <span class="snl__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7M7.5 8a2.5 2.5 0 0 1 0-5C10 3 12 8 12 8s2-5 4.5-5a2.5 2.5 0 0 1 0 5"/></svg>
            </span>
            <span>{{ ss.perk_1 }}</span>
          </li>
        {%- endif -%}
        {%- if ss.perk_2 != blank -%}
          <li class="snl__perk snl__reveal">
            <span class="snl__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M9.94 14.06 4.5 12.5l5.44-1.56L11.5 5.5l1.56 5.44 5.44 1.56-5.44 1.56L11.5 19.5z"/><path d="M19 3v4M21 5h-4"/></svg>
            </span>
            <span>{{ ss.perk_2 }}</span>
          </li>
        {%- endif -%}
        {%- if ss.perk_3 != blank -%}
          <li class="snl__perk snl__reveal">
            <span class="snl__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
            </span>
            <span>{{ ss.perk_3 }}</span>
          </li>
        {%- endif -%}
      </ul>
    </div>
  </div>
</section>

<style>
  .snl { background: var(--snl-bg); color: var(--snl-text); overflow: hidden; }
  .snl__wrap { max-width: 1180px; margin: 0 auto; padding: 0 16px; }
  .snl svg { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

  .snl__card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: 22px;
    padding: 40px 22px 30px;
    background: var(--snl-card);
    border: 1px solid var(--snl-line);
  }
  /* thin gold frame that brightens on one corner and slowly travels around the card */
  .snl__card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: conic-gradient(from var(--snl-angle, 0deg), transparent 0 70%, var(--snl-gold) 82%, transparent 94%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: snl-orbit 9s linear infinite;
    pointer-events: none;
  }
  @property --snl-angle { syntax: '<angle>'; initial-value: 0deg; inherits: false; }
  @keyframes snl-orbit { to { --snl-angle: 360deg; } }

  .snl__glow {
    position: absolute;
    z-index: -1;
    width: 520px;
    height: 520px;
    top: -260px;
    left: -140px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--snl-gold-soft), transparent 65%);
    animation: snl-drift 14s ease-in-out infinite alternate;
    pointer-events: none;
  }
  @keyframes snl-drift { to { transform: translate(180px, 120px) scale(1.15); } }

  .snl__spark {
    position: absolute;
    z-index: -1;
    color: var(--snl-gold);
    opacity: 0;
    animation: snl-twinkle 4.8s ease-in-out infinite;
    pointer-events: none;
  }
  .snl__spark--1 { top: 18%; right: 6%; font-size: 14px; }
  .snl__spark--2 { bottom: 22%; left: 8%; font-size: 10px; animation-delay: 1.6s; }
  .snl__spark--3 { top: 12%; left: 38%; font-size: 8px; animation-delay: 3.2s; }
  @keyframes snl-twinkle { 0%, 100% { opacity: 0; transform: scale(0.6) rotate(0deg); } 50% { opacity: 0.9; transform: scale(1) rotate(45deg); } }

  .snl__top { display: grid; grid-template-columns: minmax(0, 1fr); gap: 26px; text-align: center; }
  .snl__top > * { min-width: 0; }
  .snl__eyebrow {
    margin: 0 0 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 99px;
    border: 1px solid var(--snl-gold-soft);
    color: var(--snl-gold);
    font-size: 1.3rem;
    letter-spacing: 0.04em;
  }
  .snl__eyebrow svg { width: 16px; height: 16px; }
  .snl__title {
    margin: 0;
    font-size: clamp(2.4rem, 4.6vw, 3.6rem);
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--snl-text);
    background: linear-gradient(100deg, var(--snl-text) 40%, var(--snl-gold) 50%, var(--snl-text) 60%) 0 0 / 300% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: snl-sheen 7s ease-in-out infinite;
  }
  @keyframes snl-sheen { 0%, 55% { background-position: 100% 0; } 100% { background-position: 0 0; } }
  .snl__text { margin: 12px 0 0; font-size: 1.6rem; line-height: 1.7; color: var(--snl-muted); }

  .snl__form-wrap { width: 100%; max-width: 460px; margin: 0 auto; }
  .snl__form { margin: 0; }
  .snl__field {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--snl-line);
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .snl__field:focus-within { border-color: var(--snl-gold); box-shadow: 0 0 0 4px var(--snl-gold-soft); }
  .snl__input {
    flex: 1 1 auto;
    min-width: 0;
    height: 46px;
    padding: 0 16px;
    border: 0;
    background: transparent;
    color: var(--snl-text);
    font: inherit;
    font-size: 1.6rem;
    outline: none;
    box-shadow: none;
  }
  .snl__input::placeholder { color: var(--snl-muted); }
  .snl__btn {
    position: relative;
    overflow: hidden;
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 46px;
    padding: 0 22px;
    border: 0;
    border-radius: 99px;
    background: var(--snl-gold);
    color: #1a1a1a;
    font: inherit;
    font-size: 1.5rem;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .snl__btn svg { width: 18px; height: 18px; stroke-width: 2.2; transition: transform 0.25s ease; }
  .snl__btn::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 40%;
    left: -60%;
    background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.55), transparent);
    transform: skewX(-20deg);
    animation: snl-shine 5s ease-in-out infinite 1.2s;
  }
  @keyframes snl-shine { 0%, 70% { left: -60%; } 100% { left: 130%; } }
  .snl__btn:hover { transform: translateY(-1px); box-shadow: 0 8px 22px var(--snl-gold-soft); }
  .snl__btn:hover svg { transform: translateX(-4px); }
  .snl__btn:focus-visible { outline: 2px solid var(--snl-text); outline-offset: 3px; }

  .snl__consent { margin: 12px 0 0; font-size: 1.2rem; color: var(--snl-muted); }
  .snl__msg { margin: 12px 0 0; font-size: 1.5rem; display: flex; align-items: center; justify-content: center; gap: 8px; }
  .snl__msg svg { width: 20px; height: 20px; color: var(--snl-gold); stroke-width: 2.4; }
  .snl__msg--ok {
    margin: 0;
    padding: 16px 20px;
    border-radius: 16px;
    border: 1px solid var(--snl-gold-soft);
    background: rgba(255, 255, 255, 0.05);
    color: var(--snl-text);
  }
  .snl__msg--err { color: #ff9b9b; }

  .snl__perks {
    list-style: none;
    margin: 32px 0 0;
    padding: 24px 0 0;
    border-top: 1px solid var(--snl-line);
    display: grid;
    gap: 16px;
  }
  .snl__perk { display: flex; align-items: center; justify-content: center; gap: 12px; font-size: 1.45rem; color: var(--snl-muted); }
  .snl__icon {
    flex: 0 0 auto;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--snl-gold);
    background: var(--snl-gold-soft);
    transition: transform 0.3s ease;
  }
  .snl__icon svg { width: 20px; height: 20px; }
  .snl__perk:hover .snl__icon { transform: translateY(-3px) rotate(-6deg); }

  /* reveal on scroll (the script adds .is-in); without JS everything stays visible */
  .snl.js-reveal .snl__reveal { opacity: 0; transform: translateY(18px); transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .snl.js-reveal.is-in .snl__reveal { opacity: 1; transform: none; }
  .snl.is-in .snl__reveal:nth-child(2) { transition-delay: 0.08s; }
  .snl.is-in .snl__reveal:nth-child(3) { transition-delay: 0.16s; }
  .snl.is-in .snl__form-wrap { transition-delay: 0.22s; }
  .snl.is-in .snl__perk:nth-child(1) { transition-delay: 0.3s; }
  .snl.is-in .snl__perk:nth-child(2) { transition-delay: 0.4s; }
  .snl.is-in .snl__perk:nth-child(3) { transition-delay: 0.5s; }

  @media screen and (min-width: 750px) {
    .snl__card { padding: 56px 48px 36px; }
    .snl__top { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: center; gap: 48px; text-align: right; }
    .snl__form-wrap { margin: 0; }
    .snl__perks { grid-template-columns: repeat(3, 1fr); gap: 0; }
    .snl__perk { justify-content: flex-start; padding: 0 20px; }
    .snl__perk + .snl__perk { border-inline-start: 1px solid var(--snl-line); }
    .snl__perk:first-child { padding-inline-start: 0; }
    .snl__msg { justify-content: flex-start; }
  }

  @media (prefers-reduced-motion: reduce) {
    .snl__card::before, .snl__glow, .snl__spark, .snl__title, .snl__btn::after { animation: none; }
    .snl__spark { opacity: 0.5; }
    .snl.js-reveal .snl__reveal { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('snl-{{ section.id }}');
    if (!root || !('IntersectionObserver' in window)) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    root.classList.add('js-reveal');
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { root.classList.add('is-in'); io.disconnect(); }
      });
    }, { threshold: 0.25 });
    io.observe(root);
  })();
</script>

{% schema %}
{
  "name": "SEORA מועדון לקוחות",
  "tag": "div",
  "class": "section-seora-newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "כותרת קטנה", "default": "מועדון הלקוחות" },
    { "type": "text", "id": "heading", "label": "כותרת", "default": "הצטרפו למועדון הלקוחות של SEORA" },
    { "type": "text", "id": "text", "label": "טקסט", "default": "נרשמים ומקבלים ראשונים הטבות ומבצעים." },
    { "type": "text", "id": "placeholder", "label": "טקסט בשדה האימייל", "default": "כתובת מייל" },
    { "type": "text", "id": "button_label", "label": "טקסט הכפתור", "default": "הצטרפות" },
    { "type": "text", "id": "consent_text", "label": "שורת אישור מתחת לשדה", "default": "בהרשמה מאשרים לקבל דיוור מ-SEORA, ואפשר להסיר את ההרשמה בכל רגע." },
    { "type": "text", "id": "success_text", "label": "הודעה אחרי הרשמה", "default": "ההרשמה הצליחה, ההטבות הבאות יגיעו אליכם ראשונים." },
    { "type": "text", "id": "error_text", "label": "הודעת שגיאה", "default": "כדאי לבדוק את כתובת המייל ולנסות שוב." },
    { "type": "header", "content": "יתרונות" },
    { "type": "text", "id": "perk_1", "label": "יתרון 1", "default": "הטבות ומבצעים לפני כולם" },
    { "type": "text", "id": "perk_2", "label": "יתרון 2", "default": "עדכון ראשון על קולקציות חדשות" },
    { "type": "text", "id": "perk_3", "label": "יתרון 3", "default": "בלי ספאם, הסרה בלחיצה" },
    { "type": "header", "content": "עיצוב" },
    { "type": "color", "id": "bg_color", "label": "רקע הסקשן", "default": "#1f1d24" },
    { "type": "color", "id": "card_color", "label": "רקע הכרטיס", "default": "#26242c" },
    { "type": "color", "id": "text_color", "label": "צבע טקסט", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "צבע הדגשה", "default": "#d4b67a" },
    { "type": "range", "id": "padding_top", "label": "ריווח עליון", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "ריווח תחתון", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 56 }
  ],
  "presets": [{ "name": "SEORA מועדון לקוחות" }]
}
{% endschema %}
