  ],
  "presets": [
    {
      "name": "מידע מוצר - ŚEORA",
      "blocks": [
        { "type": "badges" },
        { "type": "title" },
        { "type": "rating" },
        { "type": "feature", "settings": { "icon": "diamond", "text": "מואסנייט 5.5 קראט — ברק פי 2.4 מיהלום" } },
        { "type": "feature", "settings": { "icon": "certificate", "text": "תעודת IGI בינלאומית לכל צמיד" } },
        { "type": "feature", "settings": { "icon": "shield", "text": "כסף 925 עם ציפוי זהב 14K בעובי 5 מיקרון" } },
        { "type": "feature", "settings": { "icon": "check", "text": "סוגר כספת ייחודי — יציב בענידה יומיומית" } },
        { "type": "variant_picker" },
        { "type": "bundle" },
        { "type": "price" },
        { "type": "buy_buttons" }
      ]
    }
  ]
}
{% endschema %}
