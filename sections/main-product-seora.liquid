{%- comment -%}
  ŚEORA product information section.
  Reuses the theme's media gallery, product form (cart drawer) and variant-radios logic.
  Blocks: badges, title, rating, feature, variant_picker, bundle, price, buy_buttons, text, collapsible_tab, custom_liquid, @app
{%- endcomment -%}

{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
{{ 'component-accordion.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-rating.css' | asset_url | stylesheet_tag }}
{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

<script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- if section.settings.image_zoom == 'hover' -%}
  <script id="enableZoomOnHover" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- if request.design_mode -%}
  <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign cv = product.selected_or_first_available_variant
  assign product_form_id = 'product-form-' | append: sid
  assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src'
  assign sym = s.currency_symbol | default: '₪'
  assign on_sale = false
  if cv.compare_at_price > cv.price
    assign on_sale = true
  endif
-%}

{% render 'spi-styles', section: section %}

<div id="spi-{{ sid }}" class="section-{{ sid }}-padding gradient color-{{ s.color_scheme }}">
  <div class="page-width">
    <div class="product product--{{ s.media_size }} product--{{ s.media_position }} product--{{ s.gallery_layout }} product--mobile-{{ s.mobile_thumbnails }} grid grid--1-col {% if product.media.size > 0 %}grid--2-col-tablet{% else %}product--no-media{% endif %}">
      <div class="grid__item product__media-wrapper{% if s.media_position == 'right' %} medium-hide large-up-hide{% endif %}">
        {% render 'product-media-gallery', variant_images: variant_images %}
      </div>

      <div class="product__info-wrapper grid__item">
        <product-info
          id="ProductInfo-{{ sid }}"
          data-section="{{ sid }}"
          data-url="{{ product.url }}"
          class="product__info-container{% if s.enable_sticky_info %} product__column-sticky{% endif %}"
        >
          <seora-product-info
            class="spi"
            data-section="{{ sid }}"
            data-symbol="{{ sym }}"
            data-variant-id="{{ cv.id }}"
            data-stock-in="{{ s.stock_in_text | escape }}"
            data-stock-out="{{ s.stock_out_text | escape }}"
          >
            {% render 'spi-blocks', section: section, product: product, cv: cv, sid: sid, sym: sym, on_sale: on_sale, product_form_id: product_form_id %}
          </seora-product-info>
        </product-info>
      </div>

      {%- if s.media_position == 'right' -%}
        <div class="grid__item product__media-wrapper small-hide">
          {% render 'product-media-gallery', variant_images: variant_images, is_duplicate: true %}
        </div>
      {%- endif -%}
    </div>

    {% render 'product-media-modal', variant_images: variant_images %}

    {%- if product.media.size > 0 -%}
      <script src="{{ 'product-modal.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'media-gallery.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
  </div>
</div>

{% render 'spi-script' %}

{% schema %}
{
  "name": "מידע מוצר - ŚEORA",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "טקסטים כלליים" },
    { "type": "text", "id": "stock_in_text", "label": "טקסט כשיש מלאי", "default": "במלאי - משלוח מיידי" },
    { "type": "text", "id": "stock_out_text", "label": "טקסט כשאזל", "default": "אזל מהמלאי" },
    { "type": "text", "id": "currency_symbol", "label": "סימן מטבע", "default": "₪" },

    { "type": "header", "content": "צבעים" },
    { "type": "color", "id": "accent_color", "label": "זהב (הדגשות ותגיות)", "default": "#a8894f" },
    { "type": "color", "id": "dark_color", "label": "כהה (בחירה, תגית מלאי)", "default": "#111111" },
    { "type": "color", "id": "text_color", "label": "טקסט", "default": "#111111" },
    { "type": "color", "id": "sale_color", "label": "מחיר מבצע", "default": "#c8242b" },
    { "type": "color", "id": "success_color", "label": "ירוק (חיסכון, נקודת מלאי)", "default": "#2e9e4f" },
    { "type": "color", "id": "button_bg", "label": "כפתור קנייה - רקע", "default": "#111111" },
    { "type": "color", "id": "button_text_color", "label": "כפתור קנייה - טקסט", "default": "#ffffff" },
    { "type": "range", "id": "button_radius", "label": "כפתור קנייה - עיגול פינות", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 10 },

    { "type": "header", "content": "גדלים" },
    { "type": "range", "id": "title_size", "label": "גודל כותרת", "min": 20, "max": 60, "step": 1, "unit": "px", "default": 40 },
    { "type": "range", "id": "price_size", "label": "גודל מחיר", "min": 20, "max": 72, "step": 1, "unit": "px", "default": 48 },
    { "type": "range", "id": "swatch_size", "label": "גודל עיגולי צבע", "min": 32, "max": 110, "step": 2, "unit": "px", "default": 80 },
    { "type": "range", "id": "pill_height", "label": "גובה כפתורי אופציה", "min": 40, "max": 120, "step": 2, "unit": "px", "default": 92 },
    { "type": "range", "id": "pill_min_width", "label": "רוחב מקסימלי לכפתור אופציה", "min": 60, "max": 300, "step": 5, "unit": "px", "default": 200 },

    { "type": "header", "content": "גלריית מדיה" },
    { "type": "select", "id": "media_size", "label": "גודל מדיה בדסקטופ", "options": [ { "value": "small", "label": "קטן" }, { "value": "medium", "label": "בינוני" }, { "value": "large", "label": "גדול" } ], "default": "medium" },
    { "type": "select", "id": "media_position", "label": "מיקום המדיה", "options": [ { "value": "left", "label": "שמאל" }, { "value": "right", "label": "ימין" } ], "default": "left" },
    { "type": "select", "id": "gallery_layout", "label": "פריסת גלריה", "options": [ { "value": "stacked", "label": "מוערם" }, { "value": "columns", "label": "שתי עמודות" }, { "value": "thumbnail", "label": "תמונות ממוזערות" }, { "value": "thumbnail_slider", "label": "סליידר תמונות ממוזערות" } ], "default": "thumbnail" },
    { "type": "select", "id": "mobile_thumbnails", "label": "תמונות ממוזערות במובייל", "options": [ { "value": "columns", "label": "שתי עמודות" }, { "value": "show", "label": "הצג" }, { "value": "hide", "label": "הסתר" } ], "default": "show" },
    { "type": "select", "id": "media_fit", "label": "התאמת מדיה", "options": [ { "value": "contain", "label": "הכל" }, { "value": "cover", "label": "מילוי" } ], "default": "contain" },
    { "type": "select", "id": "image_zoom", "label": "זום תמונה", "options": [ { "value": "lightbox", "label": "לייטבוקס" }, { "value": "hover", "label": "בריחוף" }, { "value": "none", "label": "ללא" } ], "default": "none" },
    { "type": "checkbox", "id": "constrain_to_viewport", "label": "הגבל מדיה לגובה המסך", "default": false },
    { "type": "checkbox", "id": "hide_variants", "label": "הסתר תמונות של וריאנטים אחרים אחרי בחירה", "default": true },
    { "type": "checkbox", "id": "display_variant_image_first", "label": "הצג תמונת וריאנט ראשונה", "default": false },
    { "type": "checkbox", "id": "enable_video_looping", "label": "וידאו בלופ", "default": true },
    { "type": "checkbox", "id": "enable_sticky_info", "label": "מידע מוצר דביק בדסקטופ", "default": true },

    { "type": "header", "content": "כללי" },
    { "type": "color_scheme", "id": "color_scheme", "label": "ערכת צבעים", "default": "background-1" },
    { "type": "range", "id": "padding_top", "label": "ריווח עליון", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "padding_bottom", "label": "ריווח תחתון", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 60 }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "badges",
      "name": "תגיות עליונות",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "badge_text", "label": "תגית 1 - טקסט", "default": "הצמיד הכי נמכר בישראל" },
        { "type": "color", "id": "badge_bg", "label": "תגית 1 - רקע", "default": "#a8894f" },
        { "type": "color", "id": "badge_color", "label": "תגית 1 - טקסט", "default": "#ffffff" },
        { "type": "text", "id": "badge2_text", "label": "תגית 2 - טקסט (לא חובה)" },
        { "type": "color", "id": "badge2_bg", "label": "תגית 2 - רקע", "default": "#f5ead6" },
        { "type": "color", "id": "badge2_color", "label": "תגית 2 - טקסט", "default": "#111111" },
        { "type": "checkbox", "id": "show_stock", "label": "הצג תגית מלאי (הטקסטים בהגדרות הסקשן)", "default": true },
        { "type": "color", "id": "stock_bg", "label": "תגית מלאי - רקע", "default": "#111111" },
        { "type": "color", "id": "stock_color", "label": "תגית מלאי - טקסט", "default": "#ffffff" },
        { "type": "color", "id": "dot_color", "label": "תגית מלאי - נקודה", "default": "#2ecc5b" }
      ]
    },
    { "type": "title", "name": "כותרת המוצר", "limit": 1, "settings": [] },
    {
      "type": "rating",
      "name": "דירוג",
      "limit": 1,
      "settings": [
        { "type": "select", "id": "source", "label": "מקור הדירוג", "options": [ { "value": "manual", "label": "ידני (ההגדרות כאן)" }, { "value": "metafield", "label": "אפליקציית ביקורות (reviews.rating), עם נפילה לידני" } ], "default": "manual" },
        { "type": "range", "id": "rating", "label": "דירוג", "min": 1, "max": 5, "step": 0.1, "default": 4.9 },
        { "type": "text", "id": "count", "label": "מספר ביקורות", "default": "984" },
        { "type": "text", "id": "count_label", "label": "מילה אחרי המספר", "default": "ביקורות" },
        { "type": "color", "id": "star_color", "label": "צבע כוכבים", "default": "#f5a623" }
      ]
    },
    {
      "type": "feature",
      "name": "שורת יתרון",
      "settings": [
        { "type": "select", "id": "icon", "label": "אייקון", "options": [
          { "value": "diamond", "label": "יהלום" }, { "value": "certificate", "label": "תעודה" }, { "value": "shield", "label": "מגן עם וי" }, { "value": "check", "label": "וי בעיגול" },
          { "value": "truck", "label": "משלוח" }, { "value": "gift", "label": "מתנה" }, { "value": "sparkles", "label": "נצנוץ" }, { "value": "ring", "label": "טבעת" },
          { "value": "heart", "label": "לב" }, { "value": "star", "label": "כוכב" }, { "value": "lock", "label": "מנעול" }, { "value": "refresh", "label": "החזרה/החלפה" },
          { "value": "clock", "label": "שעון" }, { "value": "water", "label": "עמיד במים" } ], "default": "check" },
        { "type": "text", "id": "text", "label": "טקסט", "default": "יתרון של המוצר" },
        { "type": "color", "id": "icon_color", "label": "צבע אייקון", "default": "#a8894f" }
      ]
    },
    {
      "type": "variant_picker",
      "name": "בורר וריאנטים",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "swatch_options", "label": "אופציות שיוצגו כעיגולי צבע (מופרד בפסיק)", "default": "צבע, צבע הצמיד, צבע הטבעת, Color, Colour" },
        { "type": "textarea", "id": "swatch_map", "label": "מיפוי צבעים (שורה לכל ערך: שם:CSS)", "info": "אפשר צבע או גרדיאנט. ערך שלא במיפוי יקבל את השם שלו כצבע CSS.", "default": "כסף:linear-gradient(135deg,#f6f6f6 0%,#cfcfcf 30%,#8e8e8e 60%,#e9e9e9 100%)\nצהוב:linear-gradient(135deg,#fbecb2 0%,#eacc6e 35%,#c9a24f 65%,#f5df95 100%)\nרוז:linear-gradient(135deg,#f8dcd2 0%,#ebb9a8 40%,#d99b88 70%,#f4cfc4 100%)\nזהב:linear-gradient(135deg,#fbecb2 0%,#eacc6e 35%,#c9a24f 65%,#f5df95 100%)\nרוז גולד:linear-gradient(135deg,#f8dcd2 0%,#ebb9a8 40%,#d99b88 70%,#f4cfc4 100%)\nSilver:linear-gradient(135deg,#f6f6f6 0%,#cfcfcf 30%,#8e8e8e 60%,#e9e9e9 100%)\nGold:linear-gradient(135deg,#fbecb2 0%,#eacc6e 35%,#c9a24f 65%,#f5df95 100%)\nRose Gold:linear-gradient(135deg,#f8dcd2 0%,#ebb9a8 40%,#d99b88 70%,#f4cfc4 100%)" },
        { "type": "text", "id": "bestseller_value", "label": "ערכים שיקבלו תגית (מופרד בפסיק)", "default": "16.5 ס״מ" },
        { "type": "text", "id": "bestseller_text", "label": "טקסט התגית", "default": "הנמכר ביותר" }
      ]
    },
    {
      "type": "bundle",
      "name": "שדרוג לסט",
      "limit": 1,
      "settings": [
        { "type": "product", "id": "product", "label": "מוצר משלים" },
        { "type": "range", "id": "discount_pct", "label": "אחוז הנחה על הסט", "min": 0, "max": 60, "step": 1, "unit": "%", "default": 15, "info": "ההנחה בפועל בעגלה דורשת הנחה אוטומטית תואמת ב-Shopify." },
        { "type": "text", "id": "heading", "label": "כותרת", "default": "שדרגו לסט המלא" },
        { "type": "text", "id": "label", "label": "שם הסט (ריק = שם המוצר המשלים)", "default": "צמיד + טבעת קשת" },
        { "type": "text", "id": "badge_text", "label": "תגית ({pct} = אחוז)", "default": "-{pct}% הנחה נוספת" },
        { "type": "text", "id": "link_text", "label": "טקסט קישור", "default": "למידע נוסף" }
      ]
    },
    {
      "type": "price",
      "name": "מחיר",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "save_text", "label": "טקסט חיסכון (ריק = בלי תגית)", "default": "חסכת" },
        { "type": "checkbox", "id": "show_installments", "label": "הצג שורת תשלומים", "default": true },
        { "type": "range", "id": "installments", "label": "מספר תשלומים", "min": 1, "max": 12, "step": 1, "default": 5 },
